Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^website(?:/|$) - [F,L]
</IfModule>
# Media is raster images only; HTML, SVG, scripts, archives and configuration
# must never be served directly from an uploaded-media directory.
<FilesMatch "(?i)^(?!.*\.(?:png|jpe?g|webp|gif|avif|ico)$).*$">
Require all denied
</FilesMatch>
