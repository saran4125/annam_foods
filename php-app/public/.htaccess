Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "(?i)\.(env|ini|log|sql|dump|zip|sqlite(?:3)?(?:-wal|-shm|-journal)?|db(?:-wal|-shm|-journal)?)$">
Require all denied
</FilesMatch>
