APP_ENV=local
APP_URL=http://127.0.0.1:8091
APP_SECRET=replace-with-at-least-32-random-characters
# Use a COPY of the database. Never use the live Django database for development.
DATABASE_DSN=pgsql:host=127.0.0.1;port=5439;dbname=annam_php_preview
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me
DATABASE_SSLMODE=prefer
STORE_SLUG=annam
APP_TIMEZONE=Asia/Kolkata
MEDIA_ROOT=public/media
# APP_ENV=production is refused until the rebuild passes production acceptance.
