APP_ENV=local
APP_URL=http://127.0.0.1:8091
APP_SECRET=replace-with-at-least-32-random-characters
# Use a COPY of the database. Never use the live Django database for development.
DATABASE_DSN=pgsql:host=127.0.0.1;port=5439;dbname=annam_php_preview
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me
DATABASE_SSLMODE=prefer
STORE_SLUG=annam
APP_TIMEZONE=Asia/Kolkata
MEDIA_ROOT=public/media
# Preserve the exact original Render SECRETS_KEY to decrypt existing integration credentials.
SECRETS_KEY=
# Original Django SECRET_KEY, read-only access to existing guest order receipts (optional).
DJANGO_SECRET_KEY=
# Use production only after the documented staging, provider and hosting checks pass.
# Keep providers offline until staged acceptance is complete. Callbacks still verify evidence.
PAYMENTS_ENABLED=0
MESSAGING_ENABLED=0
# Enable only after a working one-minute hosting cron has been configured.
REQUIRE_CRON=0
# Set privately for encrypted recovery commands; never commit a real passphrase.
BACKUP_PASSPHRASE=
