FROM php:8.3-apache-bookworm
# Python is used only to initialize the reference schema/catalog. Apache serves PHP.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev libonig-dev libzip-dev libcurl4-openssl-dev \
    python3 python3-venv ca-certificates \
    && docker-php-ext-install -j2 pdo_pgsql mbstring zip curl \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev \
    && docker-php-ext-install pdo_sqlite \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/annam
COPY requirements.txt ./requirements.txt
RUN --mount=type=secret,id=pip_ca \
    if [ -f /run/secrets/pip_ca ]; then export PIP_CERT=/run/secrets/pip_ca; fi; \
    python3 -m venv /opt/seed-venv \
    && /opt/seed-venv/bin/pip install --no-cache-dir -r requirements.txt
COPY . .
COPY php-app/deploy/render-apache.conf /etc/apache2/sites-available/000-default.conf
RUN chmod -R a+rX /opt/annam \
    && chmod +x php-app/deploy/render-start.sh \
    && printf 'display_errors=Off\nlog_errors=On\nexpose_php=Off\nupload_max_filesize=12M\npost_max_size=16M\n' > /usr/local/etc/php/conf.d/annam.ini
EXPOSE 10000
CMD ["/opt/annam/php-app/deploy/render-start.sh"]
