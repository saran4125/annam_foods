{
    auto_https off
    admin off
}
:80 {
    @registered host seer.localhost annam.localhost demo.localhost
    handle @registered {
        root * /var/www/html
        php_fastcgi wordpress:9000
        file_server
        @private path /wp-config.php /readme.html /wp-content/debug.log /wp-content/uploads/*.php
        respond @private 404
    }
    handle {
        respond "No store is configured for this address." 404
    }
}
