# Copy to .env; generate unique values before exposing the service.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=seerkitchen
POSTGRES_USER=seerkitchen
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5439
REDIS_URL=redis://127.0.0.1:6389/0
SECRET_KEY=replace-with-a-long-random-django-secret
SECRETS_KEY=replace-with-a-fernet-key
DEBUG=1
ALLOWED_HOSTS=annam.localhost,admin.localhost,127.0.0.1,localhost
PLATFORM_HOST=admin.localhost
# Production: comma-separated trusted HTTPS origins for the configured domains.
CSRF_TRUSTED_ORIGINS=

# Custom domains: prepare during testing; enable connections only at launch.
DOMAIN_CONNECTIONS_ENABLED=0
# The public serving edge, e.g. your-service.onrender.com (no scheme).
DOMAIN_CNAME_TARGET=
DOMAIN_APEX_IPV4=
DOMAIN_HOSTING_PROVIDER=render
# Operator-only hosting credentials. Never commit real values.
RENDER_API_KEY=
RENDER_SERVICE_ID=
